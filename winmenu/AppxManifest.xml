<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for the two tiny app packages that put QuickMorph in the Windows 11 right-click menu.
  install.py fills in the names in braces and registers one package per menu entry: Windows folds an
  app with several entries into a sub-menu, and QuickMorph's two entries should each be one click away.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  IgnorableNamespaces="uap rescap desktop4 desktop5 desktop6 com">
  <Identity Name="{IDENTITY}" Publisher="CN=QuickMorph" Version="{VERSION}" ProcessorArchitecture="neutral" />
  <Properties>
    <DisplayName>QuickMorph - {TITLE}</DisplayName>
    <PublisherDisplayName>QuickMorph</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- QuickMorph keeps its queue and log in %LOCALAPPDATA%\QuickMorph: write there for real, not to a private copy -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
  <Applications>
    <Application Id="QuickMorph" Executable="QuickMorphMenu.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements AppListEntry="none" DisplayName="QuickMorph - {TITLE}" Description="{TITLE} with QuickMorph"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="{VERB}" Clsid="{CLSID}" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="QuickMorphMenu.exe" DisplayName="QuickMorph - {TITLE}">
              <com:Class Id="{CLSID}" DisplayName="QuickMorph - {TITLE}" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
